    {
      "name": "Get Booking ( get all booking ids )",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code check\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Response is array\r",
              "pm.test(\"Response is an array\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// Array is not empty\r",
              "pm.test(\"Booking list is not empty\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "// Each item has bookingid\r",
              "pm.test(\"Each item has bookingid\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    jsonData.forEach(function(item) {\r",
              "        pm.expect(item.bookingid).to.exist;\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
